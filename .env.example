# Salin menjadi .env.local lalu isi dari Supabase Dashboard -> Project Settings -> API.
# Kedua nilai ini memang dirancang untuk dipakai di browser (dilindungi RLS).
# JANGAN PERNAH menaruh service_role key di sini atau di variabel berawalan VITE_.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
